# PostgreSQL — khi chay native (uvicorn tren host + PostgreSQL qua Docker)
DATABASE_URL=postgresql+asyncpg://technote:technote@localhost:5432/technote

# JWT secret — chuoi ngau nhien dai, giu bi mat
JWT_SECRET=change-this-to-a-long-random-secret

# Firebase FCM (HTTP v1) — lay file JSON tu Firebase Console
# Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=server/firebase-service-account.json
FCM_PROJECT_ID=technote-clubv

# URL cong khai qua ngrok
PUBLIC_URL=https://snugly-gory-goofiness.ngrok-free.dev

# VAPID public key — lay tu Firebase Console → Cloud Messaging → Web Push certificates
VAPID_PUBLIC_KEY=your-vapid-public-key-here
